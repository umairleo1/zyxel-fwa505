# Copy to .env and fill in ROUTER_PASSWORD. Commented lines show the defaults.

# ── Router ──
ROUTER_URL=https://192.168.1.1
ROUTER_USER=admin
ROUTER_PASSWORD=

# ── Polling ── (the router logs idle sessions out after 300 s, so keep both well under that)
# Router log (last 100 lines) is read this often:
POLL_INTERVAL_SEC=120
# Signal, carriers and uptime (small cellular status call; the admin page polls the same):
STATUS_INTERVAL_SEC=5

# ── Internet check ──
# The router can say mobile data is up while nothing gets through. Insight opens (and
# immediately resets) a TCP connection to the first target every interval; the others and
# the router are only tried when it fails. 3 failed rounds in a row = "Internet stalled".
# ~250 bytes a round: 1 s ≈ 0.7 GB of mobile data a month. 0 disables.
# INTERNET_PROBE_INTERVAL_SEC=1
# INTERNET_PROBE_TIMEOUT_MS=1500
# INTERNET_PROBE_TARGETS=1.1.1.1:443,8.8.8.8:443

# ── Remote syslog listener ──
# Ports below 1024 need root on macOS: point the router at this port instead of 514.
SYSLOG_PORT=5514
# 0.0.0.0 so the router can reach it; senders are still filtered (INGEST_ALLOWED_SOURCES).
SYSLOG_HOST=0.0.0.0

# ── SNMP trap listener ── (router: Maintenance → SNMP, trap destination <this-ip>:1162)
SNMP_TRAP_PORT=1162
# SNMP_TRAP_HOST=0.0.0.0
# Only accept traps with this community string (empty = accept any):
SNMP_COMMUNITY=

# Z-console TCP log receiver (separate from UDP syslog). Set 0 to disable.
# A supported high account must explicitly configure the router to send here.
# ZCONSOLE_PORT=5515
# ZCONSOLE_HOST=0.0.0.0

# Who may send syslog and SNMP traps (comma-separated IPs or hostnames, applies to both).
# Empty = only the router from ROUTER_URL. Loopback is always allowed; "*" accepts anyone.
# INGEST_ALLOWED_SOURCES=

# ── Web UI / API ──
# 127.0.0.1 = this computer only. To open it to your LAN (HOST=0.0.0.0 or a LAN IP),
# DASHBOARD_PASSWORD is required; Insight refuses to start without it.
HOST=127.0.0.1
PORT=4400
# HTTP Basic password for the dashboard (any username, e.g. "insight"). Empty = no login.
DASHBOARD_PASSWORD=
# Extra host names the dashboard may be opened by (e.g. a DNS name or reverse proxy).
# localhost, this machine's IPs and hostname(.local) are always allowed.
# ALLOWED_HOSTS=

# ── Changes to the router ── Set all four flags false for fully read-only operation.
# Messages tab: read, send and delete texts on the router's SIM.
# SMS_ENABLED=true
# Radio control: preferred network mode and bands, each change a 5-minute trial unless kept.
# RADIO_CONTROL_ENABLED=true
# System page: Restart router, as the router's own Maintenance → Reboot (at most once every 5 minutes).
# REBOOT_ENABLED=true
# High control: firmware, router backup/restore, diagnostics, WAN and accounts.
# Uses the configured router account's actual permissions; does not elevate it.
# HIGH_CONTROL_ENABLED=true

# ── Speed tests ── (Speed page and the optimiser)
# Run from this computer through the router, so wire it to the router for numbers about the
# mobile connection. They use mobile data only when run: by hand, by the optimiser, or on schedule.
# SPEEDTEST_ENABLED=true
# Every N hours (±10 %, so tests drift across the day). 0 = no schedule. Each test uses up to
# SPEEDTEST_MAX_MB, e.g. every 3 h with a 300 MB cap is up to 2.4 GB a day on a fast line.
# SPEEDTEST_EVERY_HOURS=0
# SPEEDTEST_MAX_MB=300
# A scheduled test waits while other traffic is above this (Mbps), so it measures the whole line:
# SPEEDTEST_BUSY_MBPS=5
# SPEEDTEST_DOWNLOAD_SEC=8
# SPEEDTEST_UPLOAD_SEC=6
# SPEEDTEST_STREAMS=4
# SPEEDTEST_DOWN_URL=https://speed.cloudflare.com/__down?bytes={bytes}
# SPEEDTEST_UP_URL=https://speed.cloudflare.com/__up
# Latency target (TCP handshake); empty = the first INTERNET_PROBE_TARGETS entry:
# SPEEDTEST_LATENCY_TARGET=

# ── AI insights ── (optional)
# A summary and prioritised advice on the Insights page from a local model served by Ollama
# (https://ollama.com): `ollama pull qwen3:14b`. Only aggregates are sent (no logs, and devices
# only under stand-in names), and only to OLLAMA_URL. While Ollama isn't running, the page shows
# the rule-based recommendations as before.
# AI_INSIGHTS_ENABLED=true
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:14b
# A 14B model takes ~30-60 s on a recent Mac, much longer on a Raspberry Pi:
# OLLAMA_TIMEOUT_SEC=180

# ── Storage ── (optional)
# DB_PATH=server/data/insight.db
# RETAIN_LOGS_DAYS=180
# RETAIN_SIGNAL_DAYS=90
# RETAIN_WIFI_DAYS=30
# RETAIN_SPEED_DAYS=400
# Database copies in <DB dir>/backups/insight-YYYY-MM-DD.db, newest N kept (0 = off):
# BACKUP_KEEP=4
# Days between copies. Each one copies the whole database, so weekly spares SD cards:
# BACKUP_EVERY_DAYS=7
