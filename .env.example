# Copy to .env and fill in ROUTER_PASSWORD. Commented lines show the defaults.

# ── Router ──
ROUTER_URL=https://192.168.1.1
ROUTER_USER=admin
ROUTER_PASSWORD=

# ── Polling ── (the router logs idle sessions out after 300 s, so keep both well under that)
# Router log (last 100 lines) is read this often:
POLL_INTERVAL_SEC=120
# Signal, carriers and uptime (small cellular status call; the admin page polls the same):
STATUS_INTERVAL_SEC=5

# ── Remote syslog listener ──
# Ports below 1024 need root on macOS: point the router at this port instead of 514.
SYSLOG_PORT=5514
# 0.0.0.0 so the router can reach it; senders are still filtered (INGEST_ALLOWED_SOURCES).
SYSLOG_HOST=0.0.0.0

# ── SNMP trap listener ── (router: Maintenance → SNMP, trap destination <this-ip>:1162)
SNMP_TRAP_PORT=1162
# SNMP_TRAP_HOST=0.0.0.0
# Only accept traps with this community string (empty = accept any):
SNMP_COMMUNITY=

# Who may send syslog and SNMP traps (comma-separated IPs or hostnames, applies to both).
# Empty = only the router from ROUTER_URL. Loopback is always allowed; "*" accepts anyone.
# INGEST_ALLOWED_SOURCES=

# ── Web UI / API ──
# 127.0.0.1 = this computer only. To open it to your LAN (HOST=0.0.0.0 or a LAN IP),
# DASHBOARD_PASSWORD is required; Insight refuses to start without it.
HOST=127.0.0.1
PORT=4400
# HTTP Basic password for the dashboard (any username, e.g. "insight"). Empty = no login.
DASHBOARD_PASSWORD=
# Extra host names the dashboard may be opened by (e.g. a DNS name or reverse proxy).
# localhost, this machine's IPs and hostname(.local) are always allowed.
# ALLOWED_HOSTS=

# ── Changes to the router ── Insight changes only these two things; both false = fully read-only.
# Messages tab: read, send and delete texts on the router's SIM.
# SMS_ENABLED=true
# Radio control: preferred network mode and bands, each change a 5-minute trial unless kept.
# RADIO_CONTROL_ENABLED=true

# ── Storage ── (optional)
# DB_PATH=server/data/insight.db
# RETAIN_LOGS_DAYS=180
# RETAIN_SIGNAL_DAYS=90
# RETAIN_WIFI_DAYS=30
# Database copies in <DB dir>/backups/insight-YYYY-MM-DD.db, newest N kept (0 = off):
# BACKUP_KEEP=4
# Days between copies. Each one copies the whole database, so weekly spares SD cards:
# BACKUP_EVERY_DAYS=7
